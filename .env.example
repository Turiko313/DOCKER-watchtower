# ============================================================
# Watchtower + Dashboard – Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Timezone (system-level, applies to both containers) ---
TZ=Europe/Paris

# --- Watchtower HTTP API token (minimum 32 characters, keep secret) ---
# Generate one with: openssl rand -hex 32
WATCHTOWER_API_TOKEN=

# --- Dashboard HTTP Basic credentials ---
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Dashboard CSRF/Flask secret (minimum 32 characters, keep secret) ---
# Generate one with: openssl rand -hex 32
SECRET_KEY=

# --- Dashboard port (accessible on LAN at http://<NAS_IP>:<port>) ---
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8888

# --- GHCR private registry authentication (optional) ---
# Leave empty for public packages, even when their source repository is private.
# Required only when the GHCR package itself is private.
# Create a GitHub PAT with scope read:packages at:
#   https://github.com/settings/tokens
GHCR_USERNAME=
GHCR_TOKEN=

# ============================================================
# All other Watchtower options (schedule, cleanup, notifications,
# log level, rolling restart…) are configured directly in the
# dashboard Settings page and stored in the watchtower_config
# Docker volume.  No need to set them here.
# ============================================================
